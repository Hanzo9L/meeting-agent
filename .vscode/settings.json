{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist-electron/**": true,
    "**/out/**": true,
    "**/release/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/dist-electron/**": true,
    "**/out/**": true,
    "**/release/**": true
  },
  "files.exclude": {
    "**/dist-electron": true,
    "**/out": true,
    "**/release": true
  },
  "git.autofetch": false,
  "npm.autoDetect": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.maxTsServerMemory": 2048
}
